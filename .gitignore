# Dependencies and build output
node_modules/
client/dist/
coverage/
# Playwright output
test-results/
playwright-report/
# Screenshots of the manual-style browser checks (looked at, never committed): every folder
# under reports/, so a new one is covered too; and the audit report, which lists the
# machine's leftovers.
reports/*/
reports/AUDIT-*.md
# Local data: the SQLite database and the dev admin's credentials file
data/
# The development call server binary (npm run dev:calls downloads it)
.calls-bin/
# Local configuration and secrets
.env
.env.*
# ... except the list of keys (names only, no values), which belongs in the repository.
!.env.example
# The site's settings on the server (docs/DEPLOYMENT.md): its secrets, and the local compose
# additions such as the bots' read-only mounts.
deploy/site/site.env
deploy/site/docker-compose.override.yml
.claude/settings.local.json
