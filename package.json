{
  "name": "seasonal-entertainment",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Seasonal Entertainment website: React + Vite client and Node + Express server in one repository.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:server": "npm test --workspace server",
    "test:client": "npm test --workspace client",
    "test:e2e": "node scripts/e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "marks:build": "node scripts/build-season-marks.mjs",
    "test:shared": "npm test --workspace shared",
    "dev:admin": "node scripts/create-dev-admin.mjs",
    "dev:bot-fixtures": "node scripts/build-bot-fixtures.mjs",
    "dev:calls": "node scripts/calls-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0"
  }
}
