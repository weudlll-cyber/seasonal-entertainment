# ============================================================
# File:        Caddyfile
# Path:        deploy/site/Caddyfile
# Project:     Seasonal Entertainment
# Description: Caddy for the site's VPS (docker-compose.yml in this folder): automatic HTTPS
#              (Let's Encrypt) for SITE_DOMAIN, http redirected to https, everything forwarded
#              to the site container (pages, /api, the chat WebSocket /ws/chat, /media).
#              Security headers come from the app (helmet, server/src/http/securityHeaders.js)
#              and pass through unchanged; Caddy adds none of its own. Its logs leave out the
#              embed token's headers (X-Embed-Token, the WebSocket protocol header). Further site
#              blocks (the calls domain, the www redirect) come from the folder mounted at
#              /etc/caddy/sites (./caddy/, or the installer's CADDY_SITES_DIR). ACME_CA picks
#              another certificate authority (a staging or test one); empty: Let's Encrypt.
# ============================================================
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	# Caddy's own log, which also carries the request (with its headers) of a failed proxy
	# request: the embed tokens are left out there too (as in the site's access log below).
	log default {
		output stderr
		format filter {
			wrap json
			request>headers>X-Embed-Token delete
			request>headers>X-Embed-Guest delete
			request>headers>Sec-Websocket-Protocol delete
			request>uri regexp "^(/api/auth/discord/callback|/api/chat/files/[^?]*)\?.*$" "${1}"
		}
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	# Caddy replaces any X-Forwarded-For a visitor sends with the visitor's real address;
	# the site trusts exactly this one proxy (TRUST_PROXY=1).
	reverse_proxy site:3800
	# Routes of other projects (each embedded game's installer writes its own file into
	# deploy/site/routes/, mounted here; docs/DEPLOYMENT.md). This site never edits them.
	import /etc/caddy/routes/*.caddy
	# The games' account feeds are for the games themselves, never through this proxy
	# (docs/AUTH.md): every game of deploy/install/lib/games.sh.
	@gameFeeds path /api/games/bingo/account-changes* /api/games/mini-games/account-changes*
	respond @gameFeeds 404
	log {
		output stdout
		# The access log writes request and answer headers (Caddy itself hides only Cookie,
		# Authorization and Set-Cookie): the embed token travels in X-Embed-Token, and for the
		# chat socket in the WebSocket protocol header; a guest's token on another site in
		# X-Embed-Guest, both ways (it does not expire). All are left out (docs/EMBED.md).
		format filter {
			wrap console
			request>headers>X-Embed-Token delete
			request>headers>X-Embed-Guest delete
			request>headers>Sec-Websocket-Protocol delete
			resp_headers>X-Embed-Guest delete
			# Discord's one-time code and state, and a file link's signature (?link=), are in the
			# query: those two paths are logged without it; every other request as before.
			request>uri regexp "^(/api/auth/discord/callback|/api/chat/files/[^?]*)\?.*$" "${1}"
		}
	}
}

import /etc/caddy/sites/*.caddy
