# ============================================================
# File:        seasonal-backup.timer
# Path:        deploy/site/systemd/seasonal-backup.timer
# Project:     Seasonal Entertainment
# Description: Runs seasonal-backup.service every night at 03:30 (server time), and at the
#              next boot if the server was off then.
# ============================================================

[Unit]
Description=Nightly Seasonal Entertainment backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
