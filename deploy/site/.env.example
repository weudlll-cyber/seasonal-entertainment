# Settings for deploy/site/docker-compose.yml. Copy to deploy/site/.env (never committed) and
# fill in. Names only here. The app's own settings go in deploy/site/site.env (a copy of the
# repository's .env.example; docs/DEPLOYMENT.md).
# The site's domain, e.g. example.org (Caddy gets its certificate)
SITE_DOMAIN=
# The calls domain, e.g. calls.example.org (only while the call service runs on this VPS)
CALLS_DOMAIN=
# Address Let's Encrypt writes to about the certificates
ACME_EMAIL=
# The commit being deployed (shown by /api/health); set by the update steps
COMMIT_SHA=
# Host folder for the nightly backups (default /var/backups/seasonal)
BACKUP_HOST_DIR=
# Where Caddy reaches LiveKit's signalling port (default host.docker.internal:7880)
CALLS_UPSTREAM=
