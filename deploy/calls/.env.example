# Settings for deploy/calls/docker-compose.yml. Copy to deploy/calls/.env on the call server
# (never committed) and fill in. Names only here.
# "<key>: <secret>" — the same pair as the site's CALLS_API_KEY and CALLS_API_SECRET
LIVEKIT_KEYS=
# The calls domain, e.g. calls.example.org (its certificate is in CALLS_CERT_DIR)
CALLS_DOMAIN=
# Folder holding fullchain.pem and privkey.pem for the calls domain (TURN over TLS)
CALLS_CERT_DIR=
# Only with the "proxy" profile (the call service on a VPS of its own): Let's Encrypt contact
ACME_EMAIL=
# Only with docker-compose.recording.yml (call recording, docs/DEPLOYMENT.md): the same pair
# as LIVEKIT_KEYS, as two values, for the egress service
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The host folder the recordings land in; the site reads it as its CALLS_RECORDINGS_DIR
RECORDINGS_DIR=
