# Seasonal Entertainment server configuration. Copy to .env (gitignored) and fill in.
# Names only here; never commit values. All keys are optional in development.
# Full descriptions: docs/ARCHITECTURE.md ("Runtime configuration") and docs/AUTH.md.

# Listen address and port (default 127.0.0.1:3800)
HOST=
PORT=
# "production" switches on Secure cookies and requires SESSION_SECRET
NODE_ENV=
# SQLite file (default data/seasonal.db)
DATABASE_PATH=
# Signs session cookies. Required in production; random per start otherwise
SESSION_SECRET=
# Encrypts 2FA secrets at rest: 32 random bytes as base64 (openssl rand -base64 32).
# Required in production; development uses a public development key. Keep it with the
# backups' secrets: without it, stored 2FA secrets cannot be read (accounts need a 2FA reset)
SECRET_ENCRYPTION_KEY=
# One-time token for creating the first admin (x-bootstrap-token header)
BOOTSTRAP_TOKEN=
# The site's own origin, e.g. https://example.org (CSRF and WebSocket origin checks)
PUBLIC_ORIGIN=
# Number of reverse proxies in front of the server (default 0)
TRUST_PROXY=
# true/false; default true in production
COOKIE_SECURE=
# true/false; default true: state-changing requests need an Origin/Referer header (production refuses false)
CSRF_STRICT=
# bcrypt cost, 4-15 (default 12)
BCRYPT_COST=
# true/false; default true: organisers and admins must use 2FA (false: development only)
REQUIRE_STAFF_2FA=
# Days chat messages are kept before the retention job deletes them (default 90)
CHAT_RETENTION_DAYS=
# Open live chat connections per member account: tabs, drawer and embedded chats (default 5)
CHAT_MAX_CONNECTIONS_PER_MEMBER=
# Open live chat connections per address for guests without an account (default 20)
CHAT_MAX_GUEST_CONNECTIONS_PER_IP=
# Deleted accounts (id, name, time; 30 days) for a restore, outside the backups
# (default account-deletions.jsonl beside the database)
DELETION_JOURNAL=
# Reads (GET under /api) per address and minute before 429 (default 1200; 60-1000000)
API_READS_PER_MINUTE=
# Folder of chat stickers, GIFs, preview images and uploaded files (default data/media)
MEDIA_DIR=
# true/false; default true: the server fetches previews of members' https links
LINK_PREVIEWS=
# Folder of the built client the server hands out (default client/dist)
CLIENT_DIST=
# Commit reported by /api/health (default: from git); npm run build builds it into the client
COMMIT_SHA=
# Development only: a client build commit npm run dev pretends to have, so the "new version"
# notice shows (docs/DEPLOYMENT.md, "Updating"). Empty: none, the notice never shows.
SE_DEV_BUILD_COMMIT=
# Calls (LiveKit, docs/CALLS.md). Set all three or none; none switches the Calls feature off.
# The call service's public WebSocket origin, e.g. wss://calls.example.org (ws:// only locally)
CALLS_URL=
# LiveKit API key and secret (the same pair as in deploy/calls/ on the call server).
# Production refuses LiveKit's development pair (devkey/secret) and secrets under 32 characters
CALLS_API_KEY=
CALLS_API_SECRET=
# Call recording (off unless set): the folder the recordings land in (e.g. data/recordings)
CALLS_RECORDINGS_DIR=
# The same folder as LiveKit's egress service sees it in its container (default: as above)
CALLS_EGRESS_OUTPUT_DIR=
# Backups (scripts/backup.mjs, docs/DEPLOYMENT.md): the folder they go to (14 days kept)
BACKUP_DIR=
# on (default) / off: encrypt each backup with age to BACKUP_RECIPIENT (decided 2026-10-19)
BACKUP_ENCRYPTION=
# The owner's age PUBLIC key (age1...), made on the owner's PC; never the private key
BACKUP_RECIPIENT=
# The owner's bots (docs/BOTS.md), read-only. Unset: that feature is off and the page says so.
# The price bot's snapshots.db (its path on the server; the installer mounts it at /bots/)
PRICE_BOT_DB=
# The event bot's database (its path on the server; the installer mounts it at /bots/)
EVENT_BOT_DB=
# The price bot's mining rates, mining_rates.json in its runtime folder next to snapshots.db.
# Unset, missing or invalid: the fair price and the mining times say they are not available
PRICE_BOT_MINING_RATES=
# CoinGecko Demo API key (free, coingecko.com/en/api): ETH, POL and BTC price history, fetched
# by the server only (about 78 calls a day). Unset: they show as not connected
COINGECKO_API_KEY=
# 1: the event bot's admin page is embedded at /bot-admin/ (the host's nginx asks
# /api/bot-admin/authorize first; docs/BOTS.md). Unset or 0: off, no "Manage events"
BOT_ADMIN_EMBEDDED=
# The games embedded at /games/<slug>, a comma list of bingo (Seasonal Bingo Royale),
# mini-games (Seasonal Mini Games) and race (Seasonal Race): the host's nginx asks /api/games/<slug>/authorize at the
# game's sign-in (docs/AUTH.md, "Embedded games"). Unset: none; an unknown slug stops the start
GAMES_EMBEDDED=
# 1: bingo is in GAMES_EMBEDDED as well (the switch of installs from before the list). Unset
# or 0: only GAMES_EMBEDDED counts
GAMES_BINGO_EMBEDDED=
# The games' sync token (at least 32 characters), one for all embedded games: each sends it to
# read /api/games/<slug>/account-changes over the local port. The installer makes it once in
# the root-only /etc/seasonal/games-sync-token and writes it here; never print it
GAMES_SYNC_TOKEN=
# Web push when a call starts (docs/CALLS.md): the site's VAPID key pair, base64url, both or
# neither (npx web-push generate-vapid-keys makes one; the installer makes it once). Unset: no
# push, no switch on the account page. Never print them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Discord login and roles (docs/AUTH.md, "Discord"): the application's client id, the Seasonal
# Tokens server's id, and the client secret, either as the value or in a file named here (the
# installer's way). All or none; none: no Discord button, /api/auth/discord answers 404
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_SECRET_FILE=
# The callback registered at Discord, exactly (default: PUBLIC_ORIGIN/api/auth/discord/callback)
DISCORD_REDIRECT_URI=
